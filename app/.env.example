# Conexión a PostgreSQL local
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=
PGDATABASE=uniguajira

# Sesiones: acceso corto + refresco rotativo (migración 020)
SESSION_COOKIE=ug_sesion
# Minutos que vive el token de acceso
SESSION_MINUTOS=15
REFRESH_COOKIE=ug_refresco
# Días sin usar el panel tras los que caduca el refresco (antes: SESSION_DIAS, que se sigue leyendo)
REFRESH_DIAS=7
# Tope absoluto desde el login: pasado esto se pide contraseña de nuevo
REFRESH_MAX_DIAS=30

# Credenciales del primer administrador (solo las usa `npm run db:seed`)
ADMIN_EMAIL=admin@uniguajira.edu.co
ADMIN_NOMBRE=Administrador del programa
ADMIN_PASSWORD=
